[layer_names]

2d_physics/1="body"
2d_physics/2="player_hurtbox"
2d_physics/3="enemy_hurtbox"
2d_physics/4="player_hitbox"
2d_physics/5="enemy_hitbox"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
viewport/hdr_2d=true
